{
  "name": "@kintare/eml-lib",
  "version": "2.8.0",
  "description": "Create your Electron Minecraft Launcher easily!",
  "author": "GoldFrite",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-types.mjs",
    "test": "tsx test/test.ts",
    "test-electron": "npm run build && electron dist/test/test.js",
    "release": "node .github/release.js",
    "test:unit": "npm run build && node --test test/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "compare:upstream": "node scripts/compare-upstream.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KintareStudio/EML-Lib.git"
  },
  "keywords": [
    "forge",
    "fabric",
    "neoforge",
    "quilt",
    "launcher",
    "minecraft",
    "custom",
    "nodejs",
    "electron"
  ],
  "bugs": {
    "url": "https://github.com/KintareStudio/EML-Lib/issues"
  },
  "homepage": "https://github.com/KintareStudio/EML-Lib#readme",
  "dependencies": {
    "tslib": "^2.8.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "electron": "^44.0.0",
    "electron-updater": "^6.8.9",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "electron": ">=21.0.0",
    "electron-updater": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "electron-updater": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "exports": {
    "./profiles": {
      "types": "./dist/lib/kintare/profiles.d.ts",
      "default": "./dist/lib/kintare/profiles.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./configuration": {
      "types": "./dist/lib/launcher/configuration.d.ts",
      "default": "./dist/lib/launcher/configuration.js"
    },
    "./server-target": {
      "types": "./dist/lib/serverstatus/target.d.ts",
      "default": "./dist/lib/serverstatus/target.js"
    },
    "./lib/*": "./dist/lib/*",
    "./types/*": "./dist/types/*",
    "./package.json": "./package.json",
    "./index.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/index.js.map",
    "dist/lib",
    "docs/kintare-client.es.md",
    "docs/migration-audit.es.md",
    "dist/types/*.d.ts",
    "dist/types/*.js",
    "dist/types/*.js.map",
    "docs/upstream-comparison.es.md",
    "docs/reliable-downloads.es.md",
    "docs/instance-repair.es.md",
    "docs/diagnostics-integrity.es.md"
  ]
}
